---
/**
 * LE HERO — un écran, et la porte du club dedans.
 *
 * Ce qu'il fait, dans l'ordre où un Castelginestois se pose les questions :
 * confirmer qu'il est au bon endroit (le H1), lui donner la raison de rester
 * (les disciplines), nommer le club, dire la ligne en une phrase, et ouvrir la
 * porte du club avant le premier défilement.
 *
 * Le dessin de la ligne 60 vit deux sections plus bas, sous le titre qu'il
 * illustre : ici, il coûtait presque un écran avant le premier mot sur le
 * club. Le second bouton y mène par une ancre.
 *
 * Le H1 est fixé par le cahier des charges : « accessibles depuis ».
 */
import { SITE, DESTINATION } from '../data/verite';
import { OFFRES, offresDeLaPage } from '../data/offres';
import { ARRETS, enLettres } from '../data/transports';

/** Les disciplines telles que le club les publie, dans l'ordre des pages. */
const DISCIPLINES = [
  ...offresDeLaPage('boxe-anglaise').slice(0, 1),
  ...offresDeLaPage('boxe-pieds-poings'),
  ...offresDeLaPage('mma'),
  ...offresDeLaPage('boxe-enfants'),
]
  .map((o) => o.intitule.toLowerCase())
  .join(', ')
  .replace(/, ([^,]+)$/, ' et $1');

/** Les cotes du club, projetées telles quelles depuis le registre. */
const COTES = DESTINATION.faits.filter((f) => ['Surface', 'Espaces', 'Équipement'].includes(f.cle));
---

<section class="hero" aria-labelledby="t-hero">
  <div class="enveloppe">
    <p class="hero__cartouche mono">
      <span class="hero__planche">Boxing Center</span>
      <span aria-hidden="true">·</span>
      <span>à proximité de {SITE.ville}</span>
    </p>

    <div class="hero__texte">
      <h1 id="t-hero" class="hero__titre">
        <span class="hero__ligne">Boxe, MMA et sports de combat</span>
        <span class="hero__ligne hero__ligne--accent">accessibles depuis {SITE.ville}.</span>
      </h1>

      <p class="hero__promesse">
        <strong>{DISCIPLINES.charAt(0).toUpperCase() + DISCIPLINES.slice(1)}, à {DESTINATION.nom}.</strong>
        Le 60 s’arrête {enLettres(ARRETS.length)} fois dans la commune et finit au
        métro&nbsp;; le 59 fait le reste.
      </p>

      <p class="hero__cotes mono">
        <span>{DESTINATION.adresse.split(',')[0]}</span>
        {COTES.map((f) => (
          <>
            <span aria-hidden="true">·</span>
            <span>{f.valeur}</span>
          </>
        ))}
      </p>

      <div class="hero__actions">
        <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
          <span>Réserver ma séance d’essai</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href="#trajet">
          <span>Le trajet, arrêt par arrêt</span>
          <span class="fleche" aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-block: clamp(2rem, 1rem + 4vw, 4.5rem) clamp(2.5rem, 1.5rem + 4vw, 5rem);
    background: var(--papier);
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--trait-faible) 1px, transparent 1px),
      linear-gradient(to bottom, var(--trait-faible) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: radial-gradient(120% 90% at 45% 45%, #000 0%, transparent 78%);
    opacity: 0.55;
  }
  .hero > * { position: relative; }

  .hero__cartouche {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    align-items: center;
    padding-bottom: var(--e-4);
    border-bottom: 1px solid var(--trait);
    margin-bottom: var(--e-7);
  }
  .hero__planche { color: var(--signal-texte); font-weight: 700; }

  .hero__texte { max-width: 60rem; }

  .hero__titre { max-width: 16ch; margin-bottom: var(--e-5); }
  /* La signature du site : les lignes du titre montent, avec du retard entre
     elles. Le même geste que les blocs au scroll. */
  .hero__ligne {
    display: block;
    animation: monter 900ms cubic-bezier(0.13, 0.9, 0.2, 1) both;
    animation-delay: calc(var(--i, 0) * 150ms);
  }
  .hero__ligne:nth-child(1) { --i: 0; }
  .hero__ligne:nth-child(2) { --i: 1; }
  .hero__ligne--accent { color: var(--signal-texte); }
  @keyframes monter {
    from { opacity: 0; transform: translateY(1.1em) scale(1.03); }
    to { opacity: 1; transform: none; }
  }

  .hero__promesse {
    max-width: 54ch;
    font-size: var(--t-lead);
    line-height: 1.45;
    color: var(--texte-faible);
    padding-left: var(--e-5);
    border-left: 2px solid var(--signal);
    animation: monter 900ms cubic-bezier(0.13, 0.9, 0.2, 1) 300ms both;
  }
  .hero__promesse strong { color: var(--encre); font-weight: 600; }

  .hero__cotes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-2) var(--e-3);
    margin-top: var(--e-5);
    padding-left: calc(var(--e-5) + 2px);
    color: var(--graphite);
    text-transform: none;
    letter-spacing: 0.05em;
    animation: monter 900ms cubic-bezier(0.13, 0.9, 0.2, 1) 450ms both;
  }
  .hero__cotes span:first-child { color: var(--encre); font-weight: 700; }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--e-3);
    margin-top: var(--e-6);
    animation: monter 900ms cubic-bezier(0.13, 0.9, 0.2, 1) 600ms both;
  }

  :global(.no-js) .hero__ligne,
  :global(.no-js) .hero__promesse,
  :global(.no-js) .hero__cotes,
  :global(.no-js) .hero__actions { animation: none; opacity: 1; transform: none; }

  @media (prefers-reduced-motion: reduce) {
    .hero__ligne,
    .hero__promesse,
    .hero__cotes,
    .hero__actions { animation: none !important; opacity: 1; transform: none; }
  }
</style>
