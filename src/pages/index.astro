---
/**
 * L'ACCUEIL — neuf sections, dans l'ordre des questions d'un Castelginestois.
 *
 * Le gabarit de la famille ouvre sur le moteur et range le trajet en bas. Le
 * Castelginestois, lui, lit une adresse à Toulouse en section 2 et sa question
 * suivante est « j'y vais comment ? » : alors le trajet est en 3, avec le
 * dessin de la ligne 60 comme corps de la réponse, et le moteur descend en 6,
 * après la liste des cours — on ne fait pas choisir un intitulé à quelqu'un
 * qui ne connaît pas encore les noms.
 *
 * Chaque section se referme sur une porte du club dont le libellé n'a pas
 * encore servi. Un fait s'écrit une fois par angle : le chiffre dans le héros,
 * la sensation dans « le club », la preuve dans les questions. Aucun titre de
 * section n'est un titre de la famille.
 */
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import LigneSoixante from '../components/LigneSoixante.astro';
import Seance from '../components/Seance.astro';
import Photo from '../components/Photo.astro';
import { SITE, DESTINATION, LIMITROPHES, CONTACT } from '../data/verite';
import { COMMUNES } from '../data/communes';
import { OFFRES, offresDeLaPage } from '../data/offres';
import { ROLES } from '../data/medias';
import { route } from '../data/routes';
import { ITINERAIRES, MEILLEUR, ARRIVEE, ARRETS, enLettres } from '../data/transports';

/** « a, b, c et d » depuis une liste, sans jamais l'écrire à la main. */
const enumerer = (noms: readonly string[]) =>
  noms.length > 1 ? `${noms.slice(0, -1).join(', ')} et ${noms[noms.length - 1]}` : noms[0] ?? '';

/** Les cinq portes du site, avec les intitulés exacts du club derrière chacune. */
const PORTES = [
  { id: 'boxe-anglaise', nom: 'Boxe anglaise' },
  { id: 'mma', nom: 'MMA et travail au sol' },
  { id: 'boxe-pieds-poings', nom: 'Boxe pieds-poings' },
  { id: 'preparation-physique', nom: 'Préparation physique' },
  { id: 'boxe-enfants', nom: 'Cours enfants' },
] as const;

/** Les autres trajets qui partent par la même ligne que le meilleur. */
const VARIANTES = ITINERAIRES.filter(
  (i) => i !== MEILLEUR && i.etapes[0].code === MEILLEUR.etapes[0].code
);

const COMBIEN_COURS = enLettres(OFFRES.length);
const COMBIEN_ARRETS = enLettres(ARRETS.length);
/** Les arrêts tels qu'on les dit : « l'École », « la Mairie ». */
const ARRETS_EN_TEXTE = enumerer(
  ARRETS.map((a) => a.replace(`École ${SITE.ville}`, 'l’École').replace(`Mairie ${SITE.ville}`, 'la Mairie'))
);

const VOITURE = DESTINATION.acces.split('En voiture, ')[1] ?? '';

/**
 * Les questions telles qu'on les pose. Chaque réponse s'ouvre sur ce qui est
 * vrai, et c'est ici que vit la preuve : l'adresse, les arrêts en toutes
 * lettres, la cage, la muscu, l'enfant.
 */
const QUESTIONS = [
  {
    titre: 'C’est où, exactement ?',
    texte: `Au ${DESTINATION.adresse.replace(', 31200 Toulouse', ', à Toulouse')}, à côté de la sortie 33b « Lalande » du périphérique. Pour les sports de combat à proximité de ${SITE.ville}, c’est l’adresse : ${DESTINATION.singularite.charAt(0).toLowerCase() + DESTINATION.singularite.slice(1)}`,
  },
  {
    titre: 'Comment j’y vais, en bus ou en voiture ?',
    texte: `Le 60 passe par ${ARRETS_EN_TEXTE}, puis finit à Trois Cocus. Une station de métro, et le 59 fait le reste : descends à « ${ARRIVEE.arret} ». En voiture, ${VOITURE}`,
  },
  {
    titre: 'C’est mon premier sport de combat. Je peux venir ?',
    texte:
      'Oui. Tu commences par une séance d’essai, et le coach règle l’intensité à ton niveau. Une tenue de sport et de l’eau suffisent le premier jour.',
  },
  {
    titre: 'Il y a une cage ?',
    texte:
      'Oui, une cage surélevée officielle, dans l’espace striking et travail au sol, avec 400 m² de tatamis. Sur le planning, ce cours s’appelle « Travail au Sol ».',
  },
  {
    titre: 'Je viens pour la muscu ou le cardio. C’est possible ?',
    texte:
      'C’est prévu. L’espace préparation physique fait 400 m² : seize sacs de frappe, musculation, cardio, une cage de cross-training, et un coach spécialisé en callisthénie sur l’Accès Libre.',
  },
  {
    titre: 'Mon enfant peut s’inscrire ?',
    texte:
      'Le club publie un cours « Cours Enfants », en touché contrôlé. Les jours et les tranches d’âge sont sur ses plannings hebdomadaires.',
  },
];
---

<Base page="accueil" faq={QUESTIONS}>
  <Hero />

  {/* ─────────── 02 — LE CLUB ─────────── */}
  <section class="section club" aria-labelledby="t-club">
    <div class="enveloppe club__inner">
      <div class="club__texte">
        <p class="cartouche"><span class="cartouche__num">02</span><span>Le club</span></p>
        <h2 id="t-club">
          Le club de boxe proche de {SITE.ville} est au
          <span class="club__accent">{DESTINATION.adresse.split(',')[0]}, à Toulouse.</span>
        </h2>
        <p class="lead">
          <strong>{DESTINATION.nom}</strong> est à côté de la sortie 33b
          «&nbsp;Lalande&nbsp;» du périphérique. Le 59 marque l’arrêt
          «&nbsp;{ARRIVEE.arret}&nbsp;» dans le quartier.
        </p>
        <p class="faible">
          Un club de sport de combat complet, proche de {SITE.ville}. Pendant qu’un cours de boxe occupe les deux rings, un autre groupe
          travaille au sol sur les tatamis et un troisième enchaîne aux sacs.
          Chacun garde sa place du début à la fin de la séance. Le club publie
          trois plannings, Boxe, Fitness, et MMA & Sol, et l’heure de chaque cours
          est dessus.
        </p>
        <dl class="club__faits">
          <div><dt class="mono">Adresse</dt><dd>{DESTINATION.adresse}</dd></div>
          <div><dt class="mono">Plannings</dt><dd>{DESTINATION.horairesCourt}</dd></div>
          <div><dt class="mono">Téléphone</dt><dd><a class="lien" href={`tel:${DESTINATION.telephoneLien}`}>{DESTINATION.telephone}</a></dd></div>
        </dl>
        <a class="bouton club__lien" href={DESTINATION.site} rel="noopener">
          <span>Ouvrir la page du club</span>
          <span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>

      <Photo
        slug={ROLES.hero}
        sizes="(max-width: 62rem) 100vw, 46vw"
        ratio="4 / 5"
        legende
        class="club__image"
      />
    </div>
  </section>

  {/* ─────────── 03 — Y ALLER ─────────── */}
  <section class="section creuse trajet" id="trajet" aria-labelledby="t-trajet">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">03</span><span>Y aller</span></p>
      <div class="trajet__tete">
        <h2 id="t-trajet">
          Le 60 s’arrête {COMBIEN_ARRETS} fois dans ta commune,<br />
          <span class="trajet__accent">puis finit au métro.</span>
        </h2>
        <p class="lead faible trajet__intro">
          La ligne 60 finit à Trois Cocus, sur le métro B. Une seule station
          jusqu’à La Vache, et le 59 part de là&nbsp;: tu descends au troisième
          arrêt, «&nbsp;{ARRIVEE.arret}&nbsp;». Le club est au 388 de cette avenue.
        </p>
      </div>

      <LigneSoixante />

      {VARIANTES.map((v) => {
        const [, metro, bus] = v.etapes;
        return (
          <p class="trajet__variante faible">
            Autre possibilité&nbsp;: le métro {metro.code} jusqu’à {metro.a}, puis le {bus.code},
            qui finit à «&nbsp;{bus.a}&nbsp;», {bus.jours}.
          </p>
        );
      })}

      <div class="trajet__actions">
        <a class="bouton" href={route('transports').chemin}>
          <span>Toutes les variantes du trajet</span><span class="fleche" aria-hidden="true">→</span>
        </a>
        <a class="bouton bouton--signal" href={DESTINATION.plannings} rel="noopener">
          <span>Le planning, pour choisir ton jour</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  {/* ─────────── 04 — LA PREMIÈRE SÉANCE ─────────── */}
  <section class="section premiere" aria-labelledby="t-premiere">
    <div class="enveloppe premiere__inner">
      <div class="premiere__image">
        <Photo slug={ROLES.premiereSeance} sizes="(max-width: 62rem) 100vw, 40vw" ratio="3 / 4" />
      </div>
      <div class="premiere__texte">
        <p class="cartouche"><span class="cartouche__num">04</span><span>La première fois</span></p>
        <h2 id="t-premiere">Ta première séance se passe au sac et aux pattes d’ours.</h2>
        <p class="lead faible">
          Une tenue de sport et de l’eau suffisent. Pour les gants et les bandes,
          demande au club en arrivant.
        </p>
        <ol class="premiere__etapes">
          <li><span class="mono">01</span><p><strong>Tu t’échauffes à la corde.</strong></p></li>
          <li><span class="mono">02</span><p><strong>Le coach décompose un geste, lentement,</strong> et tu le répètes au sac.</p></li>
          <li><span class="mono">03</span><p><strong>Tu finis aux pattes d’ours, avec le coach en face.</strong> Le reste de la salle est occupé à sa propre séance.</p></li>
          <li><span class="mono">04</span><p><strong>Tu repars essoufflé, et content d’être venu.</strong></p></li>
        </ol>
        <div class="premiere__actions">
          <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
            <span>Réserver cette première séance</span><span class="fleche" aria-hidden="true">↗</span>
          </a>
          <a class="lien premiere__lien" href={route('premiere-seance').chemin}>
            Le déroulé complet, minute par minute →
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ─────────── 05 — LES COURS ─────────── */}
  <section class="section encre cours" aria-labelledby="t-cours">
    <div class="enveloppe">
      <p class="cartouche"><span class="cartouche__num">05</span><span>Les cours</span></p>
      <div class="cours__tete">
        <h2 id="t-cours">{enumerer(PORTES.map((p, i) => (i ? p.nom.replace(/^([A-ZÉ])(?![A-Z])/, (c) => c.toLowerCase()) : p.nom)))}.</h2>
        <p class="lead faible cours__intro">
          Cette salle est la seule du réseau à réunir toutes les disciplines en
          un lieu, et chaque cours porte l’intitulé exact de son planning. Si tu
          cherches un club de MMA près de {SITE.ville}, l’intitulé à viser
          s’appelle «&nbsp;MMA&nbsp;», avec «&nbsp;Grappling&nbsp;» et «&nbsp;Jiu-Jitsu Brésilien&nbsp;» à côté. Voilà les {COMBIEN_COURS}
          intitulés, rangés par page.
        </p>
      </div>

      <ol class="cours__liste">
        {PORTES.map((p, i) => {
          const offres = offresDeLaPage(p.id);
          return (
            <li class="reveler" style={`--retard:${i * 60}ms`}>
              <a class="cours__page" href={route(p.id).chemin}>
                <span class="mono cours__num">{String(i + 1).padStart(2, '0')}</span>
                <span class="cours__nom">{p.nom}</span>
                <span class="fleche" aria-hidden="true">→</span>
              </a>
              <ul class="cours__intitules">
                {offres.map((o) => (
                  <li>
                    <b>{o.intitule}</b>
                    {(offres.length === 1 || o.ages) && (
                      <span class="cours__detail"> — {o.ages ?? o.detail}</span>
                    )}
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
      </ol>

      <p class="cours__source">
        <a class="bouton bouton--signal" href={DESTINATION.activites} rel="noopener">
          <span>Les {COMBIEN_COURS} activités, sur le site du club</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
      </p>
    </div>
  </section>

  {/* ─────────── 06 — LE MOTEUR ─────────── */}
  <Seance titre={'Tu sais où aller.\nChoisis quoi, et quand.'} numero="06" />

  {/* ─────────── 07 — LES QUESTIONS ─────────── */}
  <section class="section creuse questions" aria-labelledby="t-questions">
    <div class="enveloppe questions__inner">
      <div class="questions__tete">
        <p class="cartouche"><span class="cartouche__num">07</span><span>Tes dernières questions</span></p>
        <h2 id="t-questions">Ce qu’il te reste à demander,<br />en réponses courtes.</h2>
        <p class="lead faible">
          Si la tienne manque, appelle le club au
          {' '}<a class="lien" href={`tel:${CONTACT.telephoneLien.valeur}`}>{CONTACT.telephone.valeur}</a>,
          ou <a class="lien" href={route('contact').chemin}>écris-nous en deux lignes</a>.
        </p>
      </div>
      <div class="questions__liste">
        {QUESTIONS.map((q, i) => (
          <details class="qr" open={i === 0}>
            <summary>
              <span class="qr__q">{q.titre}</span>
              <span class="qr__signe" aria-hidden="true"></span>
            </summary>
            <p class="qr__r">{q.texte}</p>
          </details>
        ))}
        <p class="questions__pied mono">
          Les jours, les âges et les heures sont sur
          {' '}<a class="lien" href={DESTINATION.plannings} rel="noopener">les plannings du club ↗</a>.
        </p>
      </div>
    </div>
  </section>

  {/* ─────────── 08 — LE SECTEUR ─────────── */}
  <section class="section secteur" aria-labelledby="t-secteur">
    <div class="enveloppe">
      <p class="cartouche">
        <span class="cartouche__num">08</span>
        <span>Pour les {SITE.gentile} et le {SITE.secteur}</span>
      </p>
      <div class="secteur__tete">
        <h2 id="t-secteur">
          Le même club depuis<br />
          <span class="secteur__accent">{enumerer(COMMUNES.map((c) => c.nom))}.</span>
        </h2>
        <p class="lead faible secteur__intro">
          Chaque commune a sa page&nbsp;: la ligne à prendre, la route en
          voiture, et l’arrêt où descendre.
        </p>
      </div>

      <ul class="secteur__pages">
        {COMMUNES.map((c) => (
          <li class="reveler">
            <a class="carte" href={`/${c.id}/`}>
              <span class="mono carte__cp">{c.codePostal}</span>
              <span class="carte__nom">{c.nom}</span>
              <span class="carte__trajet">
                <span class="mono carte__ligne">{c.cotes[0].valeur}</span>
                <span aria-hidden="true">→</span>
                <span class="carte__club">{DESTINATION.nomCourt}</span>
              </span>
              <span class="mono carte__aller">Le trajet depuis {c.nom} <span aria-hidden="true">→</span></span>
            </a>
          </li>
        ))}
      </ul>

      <p class="secteur__pied">
        Boxing Center accueille les habitants de {SITE.ville} et des communes
        voisines dans son club de {DESTINATION.nomCourt}. {SITE.ville} touche
        {' '}{enLettres(LIMITROPHES.length)} communes&nbsp;: {enumerer(LIMITROPHES.map((c) => c.nom))}&nbsp;;
        {' '}{enumerer(LIMITROPHES.filter((c) => c.note).map((c) => `${c.nom} est ${c.note}`))}.
      </p>
    </div>
  </section>

  {/* ─────────── 09 — DÉCIDER ─────────── */}
  <section class="section creuse convergence" aria-labelledby="t-convergence">
    <div class="enveloppe convergence__inner">
      <p class="cartouche"><span class="cartouche__num">09</span><span>Décider</span></p>
      <h2 id="t-convergence">
        Réserve ta séance d’essai,<br />
        <span class="convergence__accent">ou pose ta question.</span>
      </h2>
      <p class="lead convergence__texte">
        La séance d’essai se réserve sur le site du club. Si tu préfères
        demander d’abord, appelle le club ou écris-nous en deux lignes&nbsp;: on
        te répond.
      </p>
      <div class="convergence__actions">
        <a class="bouton bouton--signal" href={DESTINATION.tarifs} rel="noopener">
          <span>Ma séance d’essai, sur le site du club</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
        <a class="bouton" href={route('contact').chemin}>
          <span>Poser ma question</span><span class="fleche" aria-hidden="true">→</span>
        </a>
        <a class="bouton" href={`tel:${CONTACT.telephoneLien.valeur}`}>
          <span>{CONTACT.telephone.valeur}</span><span class="fleche" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ── 02 Le club ────────────────────────────────────────────────────── */
  .club__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.85fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .club__inner { grid-template-columns: 1fr; gap: var(--e-7); } }
  .club h2 { max-width: 20ch; margin-bottom: var(--e-5); }
  .club__accent { display: block; color: var(--signal-texte); }
  .club .lead { max-width: 46ch; margin-bottom: var(--e-4); }
  .club .faible { max-width: 54ch; }

  .club__faits { margin: var(--e-6) 0; }
  .club__faits > div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: var(--e-3);
    padding: var(--e-3) 0;
    border-top: 1px solid var(--trait);
    font-size: var(--t-petit);
  }
  .club__faits > div:last-child { border-bottom: 1px solid var(--trait); }
  @media (max-width: 34rem) { .club__faits > div { grid-template-columns: 1fr; gap: 0.2rem; } }
  .club__faits dt { color: var(--graphite); padding-top: 0.15em; }
  .club__faits dd { margin: 0; }

  /* ── 03 Y aller ────────────────────────────────────────────────────── */
  .trajet__tete {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 62rem) { .trajet__tete { grid-template-columns: 1fr; } }
  .trajet h2 { max-width: 18ch; }
  .trajet__accent { color: var(--signal-texte); }
  .trajet__intro { max-width: 50ch; }
  .trajet__variante { max-width: 60ch; margin-top: var(--e-5); font-size: var(--t-petit); }
  .trajet__actions { display: flex; flex-wrap: wrap; gap: var(--e-3); margin-top: var(--e-6); }

  /* ── 04 Première séance ────────────────────────────────────────────── */
  .premiere__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--e-8);
    align-items: center;
  }
  @media (max-width: 62rem) { .premiere__inner { grid-template-columns: 1fr; } }
  .premiere h2 { max-width: 18ch; margin-bottom: var(--e-4); }
  .premiere .lead { max-width: 46ch; margin-bottom: var(--e-5); }
  .premiere__etapes { list-style: none; display: grid; }
  .premiere__etapes li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--e-4);
    padding: var(--e-4) 0;
    border-top: 1px solid var(--trait);
  }
  .premiere__etapes li:last-child { border-bottom: 1px solid var(--trait); }
  .premiere__etapes .mono { color: var(--signal-texte); padding-top: 0.3em; font-weight: 700; }
  .premiere__etapes p { font-size: var(--t-petit); color: var(--texte-faible); max-width: 56ch; }
  .premiere__etapes strong { color: var(--encre); font-weight: 600; }
  .premiere__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--e-4); margin-top: var(--e-6); }
  .premiere__lien { font-size: var(--t-petit); }

  /* ── 05 Les cours ──────────────────────────────────────────────────── */
  .cours__tete {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--e-5) var(--e-8);
    align-items: end;
    margin-bottom: var(--e-7);
  }
  @media (max-width: 56rem) { .cours__tete { grid-template-columns: 1fr; } }
  .cours h2 { max-width: 22ch; }
  .cours__intro { max-width: 48ch; }

  .cours__liste { list-style: none; }
  .cours__liste > li {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--e-3) var(--e-6);
    align-items: baseline;
    padding: var(--e-4) 0;
    border-top: 1px solid var(--trait);
  }
  .cours__liste > li:last-child { border-bottom: 1px solid var(--trait); }
  @media (max-width: 48rem) { .cours__liste > li { grid-template-columns: 1fr; gap: var(--e-2); } }
  .cours__page {
    display: flex;
    align-items: baseline;
    gap: var(--e-3);
    text-decoration: none;
    color: inherit;
    transition: transform var(--d-normal) var(--e-sortie);
  }
  .cours__page:hover { transform: translateX(4px); }
  .cours__page .fleche { color: var(--signal-texte); }
  .cours__num { color: var(--signal-texte); font-weight: 700; }
  .cours__nom { font-family: var(--police-titre); font-size: var(--t-h3); font-weight: 700; letter-spacing: -0.015em; }
  .cours__intitules { list-style: none; display: flex; flex-wrap: wrap; gap: var(--e-2) var(--e-4); font-size: var(--t-petit); color: var(--texte-faible); }
  .cours__intitules b { color: var(--texte); font-weight: 600; }
  .cours__detail { color: var(--texte-faible); }
  .cours__source { margin-top: var(--e-6); }

  /* ── 07 Questions ──────────────────────────────────────────────────── */
  .questions__inner {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: var(--e-8);
    align-items: start;
  }
  @media (max-width: 62rem) { .questions__inner { grid-template-columns: 1fr; gap: var(--e-6); } }
  .questions__tete h2 { max-width: 16ch; margin-bottom: var(--e-4); }
  .questions__tete .lead { max-width: 40ch; }
  .questions__pied { margin-top: var(--e-5); color: var(--graphite); text-transform: none; letter-spacing: 0.04em; }

  /* ── 08 Secteur ────────────────────────────────────────────────────── */
  .secteur__tete {
